  "transcript": [
    {
      "item_id": "t1",
      "speaker": "DOCTOR",
      "text": "Let's run through the intake questions, this won't take long.",
      "start_offset_ms": 0,
      "end_offset_ms": 3355
    },
    {
      "item_id": "t2",
      "speaker": "DOCTOR",
      "text": "Do you smoke, or have you in the past?",
      "start_offset_ms": 3355,
      "end_offset_ms": 5445
    },
    {
      "item_id": "t3",
      "speaker": "PATIENT",
      "text": "I quit about three years ago now. Twenty years before that.",
      "start_offset_ms": 5445,
      "end_offset_ms": 8690
    },
    {
      "item_id": "t4",
      "speaker": "DOCTOR",
      "text": "How about alcohol?",
      "start_offset_ms": 8690,
      "end_offset_ms": 10190
    },
    {
      "item_id": "t5",
      "speaker": "PATIENT",
      "text": "A glass of wine maybe once a week, that's it.",
      "start_offset_ms": 10190,
      "end_offset_ms": 12665
    },
    {
      "item_id": "t6",
      "speaker": "DOCTOR",
      "text": "Are you working at the moment?",
      "start_offset_ms": 12665,
      "end_offset_ms": 14315
    },
    {
      "item_id": "t7",
      "speaker": "PATIENT",
      "text": "Yes, full time. Same place for twelve years.",
      "start_offset_ms": 14315,
      "end_offset_ms": 16735
    },
    {
      "item_id": "t8",
      "speaker": "DOCTOR",
      "text": "Do you feel safe where you live?",
      "start_offset_ms": 16735,
      "end_offset_ms": 18495
    },
    {
      "item_id": "t9",
      "speaker": "PATIENT",
      "text": "Yes, absolutely. No problems there at all.",
      "start_offset_ms": 18495,
      "end_offset_ms": 20805
    },
    {
      "item_id": "t10",
      "speaker": "DOCTOR",
      "text": "Any worries about housing?",
      "start_offset_ms": 20805,
      "end_offset_ms": 22305
    },
    {
      "item_id": "t11",
      "speaker": "PATIENT",
      "text": "No, we own the place. Nine years now.",
      "start_offset_ms": 22305,
      "end_offset_ms": 24340
    },
    {
      "item_id": "t12",
      "speaker": "DOCTOR",
      "text": "Do you wear a seatbelt?",
      "start_offset_ms": 24340,
      "end_offset_ms": 25840
    },
    {
      "item_id": "t13",
      "speaker": "PATIENT",
      "text": "Always. Every single time, it's the job.",
      "start_offset_ms": 25840,
      "end_offset_ms": 28040
    },
    {
      "item_id": "t14",
      "speaker": "DOCTOR",
      "text": "Great, that's everything I needed. I'll get this written up.",
      "start_offset_ms": 28040,
      "end_offset_ms": 31340
    }
  ],
